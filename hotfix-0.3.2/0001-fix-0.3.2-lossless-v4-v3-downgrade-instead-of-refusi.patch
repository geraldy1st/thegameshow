+import { describe, expect, it } from 'vitest';
+import { ManualClock } from '../core/clock';
+import { createGameStore } from '../store/gameStore';
+import { openSaveDb, type SaveDb } from './db';
+import { DOWNGRADE_ANNOUNCEMENT, DOWNGRADE_SLOT, sameV3Fields } from './downgrade';
+import { validateSaveV3 } from './schema';
+
+/**
+ * GS-V5-65 on the 0.3.2 build (OD-18 v1.3): Crypto's 4 v3 saves passed to v4 by lot 4 (with 5
+ * taps of `work`) plus a new v4 game. The 0.3.2 app downgrades instead of refusing.
+ */
+type Fx = { slots: Record<string, Record<string, unknown>> };
+const FX = Object.fromEntries(
+  Object.entries(
+    import.meta.glob<Fx>('./__fixtures__/gs-v5-65/*.json', { eager: true, import: 'default' }),
+  ).map(([p, v]) => [p.split('/').pop()!, v]),
+);
+let n = 0;
+
+async function seed(fx: Fx): Promise<{ name: string; db: SaveDb }> {
+  const name = `hotfix-${++n}`;
+  const db = await openSaveDb(name);
+  for (const [slot, v] of Object.entries(fx.slots)) await db.put('saves', v, slot as never);
+  return { name, db };
+}
+const app032 = (name: string, now: number, writer = true) =>
+  createGameStore({
+    clock: new ManualClock(now),
+    openDb: () => openSaveDb(name),
+    newSeed: () => 1,
+    acquireWriterLock: async () => writer,
+    debounceMs: 5,
+  });
+
+describe('GS-V5-65: the 0.3.2 app downgrades a lot 4 save without loss', () => {
+  for (const f of Object.keys(FX)) {
+    it(f, async () => {
+      const fx = structuredClone(FX[f]!);
+      const v4 = fx.slots.current!;
+      expect(v4.schemaVersion).toBe(4);
+      const { name, db } = await seed(fx);
+      const s = app032(name, v4.maxSeenAt as number);
+      await s.getState().init();
+      expect(s.getState().status).toBe('ready');
+      expect(s.getState().announcement).toBe(DOWNGRADE_ANNOUNCEMENT);
+      expect(s.getState().announcement).toBe('Sauvegarde ramenée à la version précédente du jeu');
+      // In memory and stored: every v3 field deep-equal, `work` dropped, schemaVersion 3.
+      const g = s.getState().game!;
+      expect(sameV3Fields(g, v4)).toBe(true);
+      const v3expected: Record<string, unknown> = { ...v4 };
+      delete v3expected.work;
+      expect({ ...g, revision: 0, lastSeenAt: 0, maxSeenAt: 0 }).toEqual({
+        ...v3expected,
+        schemaVersion: 3,
+        revision: 0,
+        lastSeenAt: 0,
+        maxSeenAt: 0,
+      });
+      const cur = (await db.get('saves', 'current')) as Record<string, unknown>;
+      expect(cur.schemaVersion).toBe(3);
+      expect(validateSaveV3(cur).ok).toBe(true);
+      expect(sameV3Fields(cur, v4)).toBe(true);
+      expect(await db.get('saves', DOWNGRADE_SLOT)).toEqual(v4);
+      // Reload: no second announcement, nothing rewritten in the kept copy.
+      const s2 = app032(name, v4.maxSeenAt as number);
+      await s2.getState().init();
+      expect(s2.getState().announcement).toBe('');
+      expect(await db.get('saves', DOWNGRADE_SLOT)).toEqual(v4);
+      db.close();
+    });
+  }
+
+  it('a read-only tab downgrades in memory and writes nothing', async () => {
+    const fx = structuredClone(FX['v4-from-v4-fresh.json']!);
+    const { name, db } = await seed(fx);
+    const s = app032(name, fx.slots.current!.maxSeenAt as number, false);
+    await s.getState().init();
+    expect(s.getState().status).toBe('readonly');
+    expect(s.getState().game!.schemaVersion).toBe(3);
+    expect(await db.get('saves', 'current')).toEqual(fx.slots.current);
+    expect(await db.get('saves', DOWNGRADE_SLOT)).toBeUndefined();
+    db.close();
+  });
+
+  it('v5 is still refused without any write', async () => {
+    const fx = structuredClone(FX['v4-from-v4-fresh.json']!);
+    const v5 = { ...fx.slots.current, schemaVersion: 5 };
+    const { name, db } = await seed({ slots: { current: v5 } });
+    const s = app032(name, 0);
+    await s.getState().init();
+    expect(s.getState().recoveryKind).toBe('future');
+    expect(await db.get('saves', 'current')).toEqual(v5);
+    db.close();
+  });
+
+  it('unreadable current with a v4 previous: downgraded, raw v4 kept', async () => {
+    const fx = structuredClone(FX['v4-from-v4-fresh.json']!);
+    const { name, db } = await seed({
+      slots: { current: { junk: true } as never, previous: fx.slots.current! },
+    });
+    const s = app032(name, fx.slots.current!.maxSeenAt as number);
+    await s.getState().init();
+    expect(s.getState().game!.schemaVersion).toBe(3);
+    expect(await db.get('saves', DOWNGRADE_SLOT)).toEqual(fx.slots.current);
+    db.close();
+  });
+});
