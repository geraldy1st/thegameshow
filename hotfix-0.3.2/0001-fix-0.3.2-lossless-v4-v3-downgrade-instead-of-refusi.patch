diff --git a/e2e/downgrade.spec.ts b/e2e/downgrade.spec.ts
new file mode 100644
index 0000000..052416c
--- /dev/null
+++ b/e2e/downgrade.spec.ts
@@ -0,0 +1,86 @@
+import { readdirSync, readFileSync } from 'node:fs';
+import { expect, test, type Page } from '@playwright/test';
+
+/**
+ * GS-V5-65 (OD-18 v1.3) on the 0.3.2 build: Crypto's 4 saves passed to v4 by lot 4 (5 taps of
+ * `work`) and a new v4 game are downgraded without loss, announced once, raw v4 kept.
+ */
+const DIR = 'src/save/__fixtures__/gs-v5-65';
+test.use({ baseURL: 'http://localhost:4181/thegameshow/' });
+type Fx = { slots: Record<string, Record<string, unknown>>; marker: string | null };
+
+async function seed(page: Page, fx: Fx) {
+  await page.goto('./__seed');
+  await page.evaluate(
+    ({ slots, marker }) =>
+      new Promise<void>((resolve, reject) => {
+        if (marker) localStorage.setItem('tgs-reveal-seen', marker);
+        const req = indexedDB.open('thegameshow', 1);
+        req.onupgradeneeded = () => req.result.createObjectStore('saves');
+        req.onerror = () => reject(req.error);
+        req.onsuccess = () => {
+          const tx = req.result.transaction('saves', 'readwrite');
+          for (const [k, v] of Object.entries(slots)) tx.objectStore('saves').put(v, k);
+          tx.oncomplete = () => {
+            req.result.close();
+            resolve();
+          };
+        };
+      }),
+    fx,
+  );
+}
+const slot = (page: Page, key: string) =>
+  page.evaluate(
+    (key) =>
+      new Promise<unknown>((resolve) => {
+        const req = indexedDB.open('thegameshow', 1);
+        req.onsuccess = () => {
+          const g = req.result.transaction('saves').objectStore('saves').get(key);
+          g.onsuccess = () => {
+            req.result.close();
+            resolve(g.result);
+          };
+        };
+      }),
+    key,
+  );
+const BOOK = ['schemaVersion', 'revision', 'lastSeenAt', 'maxSeenAt', 'work'];
+const v3Fields = (o: unknown) =>
+  Object.fromEntries(
+    Object.entries(o as Record<string, unknown>).filter(([k]) => !BOOK.includes(k)),
+  );
+
+test.beforeEach(async ({ page }) => {
+  await page.route('**/thegameshow/__seed', (r) =>
+    r.fulfill({ contentType: 'text/html', body: '<!doctype html><title>seed</title>' }),
+  );
+});
+
+for (const f of readdirSync(DIR)) {
+  test(`GS-V5-65 ${f}: downgraded without loss, announced, raw v4 kept`, async ({ page }) => {
+    const fx = JSON.parse(readFileSync(`${DIR}/${f}`, 'utf8')) as Fx;
+    // Test-harness build with the clock frozen at the save's own time: no absence credited and
+    // no idle income while the test reads, so the stored v3 is compared field by field.
+    const v4 = fx.slots.current!;
+    await seed(page, fx);
+    await page.goto(`./?now=${v4.maxSeenAt as number}`);
+    await expect(page.getByRole('status')).toHaveText(
+      'Sauvegarde ramenée à la version précédente du jeu',
+    );
+    await expect(page.getByRole('button', { name: 'Travailler avec Aoi' })).toBeVisible();
+    await expect
+      .poll(async () => (await slot(page, 'current')) as object)
+      .toMatchObject({
+        schemaVersion: 3,
+      });
+    const cur = (await slot(page, 'current')) as Record<string, unknown>;
+    expect(cur.work).toBeUndefined();
+    expect(v3Fields(cur)).toEqual(v3Fields(v4));
+    expect(await slot(page, 'backup-before-downgrade-v4')).toEqual(v4);
+    await page.reload();
+    await expect(page.getByRole('button', { name: 'Travailler avec Aoi' })).toBeVisible();
+    await expect(page.getByRole('status')).toHaveText('');
+    expect(await slot(page, 'backup-before-downgrade-v4')).toEqual(v4);
+  });
+}
