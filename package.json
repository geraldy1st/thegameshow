{
  "name": "thegameshow",
  "private": true,
  "version": "0.5.2",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:test-harness": "tsc -b && vite build --mode test-harness --outDir dist-test",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check:no-test-hook": "node tools/check-no-test-hook.mjs",
    "check:all": "npm run typecheck && npm run lint && npm run test && npm run build && npm run check:no-test-hook && npm run check:no-budget-fake",
    "check:harness-detected": "npm run build:test-harness && node tools/check-harness-detected.mjs dist-test",
    "test:e2e": "playwright test",
    "check:no-budget-fake": "node tools/check-no-budget-fake.mjs",
    "budget:home": "node tools/measure-home-budget.mjs dist",
    "budget:gauge": "node tools/build-budget-fake.mjs && node tools/measure-home-budget.mjs dist-budget-fake --expect-fail",
    "budget:work": "node tools/measure-budget.mjs dist --screen work && node tools/measure-budget.mjs dist --screen work --direct",
    "budget:work:still": "node tools/measure-budget.mjs dist --screen work --still",
    "budget:work:gauge": "node tools/build-budget-fake-work.mjs && node tools/measure-budget.mjs dist-budget-fake-work --screen work --expect-fail"
  },
  "dependencies": {
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "idb": "^8.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.55.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.6",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
